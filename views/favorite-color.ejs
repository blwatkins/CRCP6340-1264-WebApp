<%- include('./layouts/page-top.ejs', pageData); %>
<main class="container flex-grow-1 d-flex flex-column justify-content-start justify-content-md-center">
    <div class="w-100">
        <div class="row g-4 m-2">
            <div class="col-12 text-center">
                <h1 class="heading">What is your favorite color?</h1>
            </div>
        </div>
        <div class="row align-items-center g-4 m-2">
            <div class="col-12 col-md-6">
                <form id="favorite-color-form">
                    <div class="mb-3">
                        <label class="form-label"
                               for="name-input">Name</label>
                        <input id="name-input"
                               class="form-control disable-toggle"
                               type="text" name="name" placeholder="John Doe" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"
                               for="color-input">Favorite Color</label>
                        <input id="color-input"
                               class="form-control disable-toggle"
                               type="text" name="color" maxlength="7" placeholder="#000000" required />
                    </div>
                    <div class="mb-3">
                        <button id="submit-button"
                                class="btn btn-success w-100 disable-toggle"
                                type="submit">
                            Submit
                        </button>
                    </div>
                    <div id="form-alert-div" class="mb-3 w-100 alert" role="alert" hidden></div>
                </form>
            </div>
            <div class="col-12 col-md-6 d-flex justify-content-center">
                <div id="color-preview-div"
                     class="mx-auto rounded-4 color-preview border border-dark border-3"
                     style="background:black;" >
                    &nbsp;
                </div>
            </div>
        </div>
    </div>
</main>
<%- include('./layouts/page-bottom.ejs'); %>
